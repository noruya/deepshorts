# ---- Gemini API ----
# Free tier for gemini-2.5-flash: tokens are free, limited to 15 RPM / 1500 RPD.
# (gemini-3.5-flash is newer but its free tier is capped at ~20 requests/DAY, which
# throttles generation — stick with 2.5-flash unless you've enabled billing.)
# NEVER commit your real key. Copy this file to `.env` and fill it in.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ---- Orchestration ----
MAX_ITERATIONS=2          # max critic -> revise loops (loop guard)
ENABLE_THINKING=true      # use Gemini thinking + capture thought summaries
TEMPERATURE=1.0

# ---- Rate limiting / resilience (stay safely under free-tier caps) ----
RPM_LIMIT=12              # < 15 requests/min
RPD_LIMIT=1400            # < 1500 requests/day
MAX_RETRIES=5             # retry-with-backoff on 429/5xx
REQUEST_TIMEOUT_S=120

# ---- AI 작가회의 (Writers' Room) ----
LLM_PROVIDER=gemini       # gemini | openai — 공급자 교체
# OpenAI 호환 공급자를 쓸 때만 입력 (OpenAI, Anthropic 호환 게이트웨이, Ollama 등):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MAX_ROUNDS=2              # 토론 루프: 작가 3명 × N라운드

# ---- CORS ----
# Default (if unset) is ["*"] — fine for this app: public, unauthenticated, no cookies.
# Override here only if you want to lock dev down to specific origins instead.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
